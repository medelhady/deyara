NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which provider sends and receives WhatsApp messages: meta or twilio. Production runs on meta.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API, used when WHATSAPP_PROVIDER=meta.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Any string you choose. Paste the same one into the Meta webhook setup form.
META_VERIFY_TOKEN=
# Meta app secret, from App settings > Basic. Required: without it the webhook accepts unsigned
# requests, and the sender number on a request is what authorises the admin WhatsApp commands.
META_APP_SECRET=

# Twilio, used when WHATSAPP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

OPENAI_API_KEY=

# Signs the dashboard session cookie. Any long random string. Falls back to ADMIN_ACCESS_TOKEN when
# empty. In production, if both are empty the dashboard refuses every request rather than opening.
ADMIN_SESSION_SECRET=

# Bootstrap key for the dashboard. Before any login account exists it works as the password on the
# login page, so the first person can get in and create accounts at /admin/accounts. It stops
# working as soon as one account exists.
ADMIN_ACCESS_TOKEN=

# Protects the scheduled job that reminds owners to review their listings. Any long random string,
# and the same value must be set in Vercel so its cron can call the endpoint. In production the job
# refuses to run without it rather than leaving a message-sending URL open.
CRON_SECRET=

# The number invite links open a chat with, shown in the referral pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Fallbacks only. Prices, rates, payment number and admin numbers are edited at /admin/settings and
# stored in the app_settings table; these apply until a value is saved there.
ADMIN_WHATSAPP_NUMBERS=whatsapp:+22200000000
CONTACT_REQUEST_FEE=1
POINTS_PAYMENT_NUMBER=+22200000000
CONTACT_REVEAL_NOTE=
